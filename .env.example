

DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/sentineth

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openrouter/free
# Which embedding model to use. "nvidia" calls nemotron-3-embed-1b on
# NVIDIA's hosted API Catalog and is the primary model: recall@5 82.4% ->
# 95.1% on the eval set against all-MiniLM-L6-v2, p=0.004. That is not a
# margin to leave on the wrong side of a default, so "nvidia" is what the
# application runs when this is unset, and it needs NVIDIA_API_KEY below.
#
# "local" runs all-MiniLM-L6-v2 on the CPU. It is the offline fallback -
# no key, no network - and is what CI and disconnected development use.
#
# Changing this changes vector length (2048 vs 384). A collection's vector
# size is fixed at creation, so a switch is a reindex into a new
# collection, never an in-place change: run scripts/reindex.py against the
# target collection first, then change these two values and restart.
#
# QDRANT_COLLECTION is left unset on purpose. Unset, it is derived from
# EMBEDDING_PROVIDER (nvidia -> sentineth_documents_nemotron, local ->
# sentineth_documents), so the two cannot drift into a state where 2048-
# dimension vectors are written to a 384-dimension collection. Set it only
# to point at a collection built by a reindex.
EMBEDDING_PROVIDER=nvidia
# QDRANT_COLLECTION=

# Two retrieval additions, both off, both measured harmful on the current
# eval set - see eval/harness.py and the commit that added them.
#
# QDRANT_HYBRID indexes a lexical vector beside the dense one and fuses the
# two. It cost 12.7 points of recall@1 (77.5% -> 64.7%) and improved zero
# questions out of 102: the lexical retriever found nothing the dense one
# missed. Fixed when the collection is created, so changing it means a
# reindex into a new collection, not a restart.
#
# RERANK re-scores the top 30 with a cross-encoder. It cost 10.8 points of
# recall@1 and adds a model to the process plus 30 forward passes per
# search. The cross-encoder is simply the weaker model of the two here.
#
# Both are worth re-measuring on a corpus full of identifiers, error codes
# or part numbers, which is what lexical matching is for and which this
# eval set does not contain.
QDRANT_HYBRID=false
RERANK=false

# The second-pass company-knowledge extractor sends at most this many source
# characters in one LLM request and rejects documents that produce more than
# this many proposals. Extracted claims require human review before retrieval.
SENTINETH_KNOWLEDGE_BATCH_CHARS=12000
SENTINETH_MAX_KNOWLEDGE_PROPOSALS=1000

# Required unless EMBEDDING_PROVIDER=local. Key comes from
# https://build.nvidia.com and starts with "nvapi-". Without it the API and
# the worker fail closed at first use with a 503 rather than silently
# falling back to a weaker model.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
