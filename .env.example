

DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/sentineth

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openrouter/free
# Which embedding model to use. "local" runs all-MiniLM-L6-v2 on the CPU;
# "nvidia" calls nemotron-3-embed-1b on NVIDIA's hosted API Catalog.
# Changing this changes vector length (384 vs 2048), so it must be changed
# together with QDRANT_COLLECTION and preceded by scripts/reindex.py.
#
# "nvidia" is the better retriever by a wide margin - recall@5 82.4% ->
# 95.1% on the 102-question eval set, p=0.004 - and is what a deployment
# with a key should run. The default stays "local" because it needs no key
# and no network, which is what CI and offline development have.
EMBEDDING_PROVIDER=local
QDRANT_COLLECTION=sentineth_documents

# Two retrieval additions, both off, both measured harmful on the current
# eval set - see eval/harness.py and the commit that added them.
#
# QDRANT_HYBRID indexes a lexical vector beside the dense one and fuses the
# two. It cost 12.7 points of recall@1 (77.5% -> 64.7%) and improved zero
# questions out of 102: the lexical retriever found nothing the dense one
# missed. Fixed when the collection is created, so changing it means a
# reindex into a new collection, not a restart.
#
# RERANK re-scores the top 30 with a cross-encoder. It cost 10.8 points of
# recall@1 and adds a model to the process plus 30 forward passes per
# search. The cross-encoder is simply the weaker model of the two here.
#
# Both are worth re-measuring on a corpus full of identifiers, error codes
# or part numbers, which is what lexical matching is for and which this
# eval set does not contain.
QDRANT_HYBRID=false
RERANK=false

# Only needed when EMBEDDING_PROVIDER=nvidia. Key comes from
# https://build.nvidia.com and starts with "nvapi-".
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
